$ touch perm_file.txt && mkdir -p perm_dir

# 변경 전
$ ls -l perm_file.txt
-rw-r--r-- 1 gogosing gogosing 0 Nov  6 01:26 perm_file.txt

$ ls -ld perm_dir
drwxr-xr-x 2 gogosing gogosing 4096 Nov  6 01:26 perm_dir

$ stat -c "%A %a %n" perm_file.txt perm_dir
-rw-r--r-- 644 perm_file.txt
drwxr-xr-x 755 perm_dir

# 변경: 파일 644 -> 600 -> 755, 디렉토리 755 -> 700
$ chmod 600 perm_file.txt

$ stat -c "%A %a %n" perm_file.txt
-rw------- 600 perm_file.txt

$ chmod 755 perm_file.txt

$ stat -c "%A %a %n" perm_file.txt
-rwxr-xr-x 755 perm_file.txt

$ chmod 700 perm_dir

$ stat -c "%A %a %n" perm_dir
drwx------ 700 perm_dir

# 기호 방식: 그룹·기타에 읽기+실행 다시 주기
$ chmod go+rx perm_dir

$ stat -c "%A %a %n" perm_dir
drwxr-xr-x 755 perm_dir

# 실행 권한(x)의 효과 확인
$ printf "#!/bin/bash\necho script ran\n" > hello.sh

$ chmod 644 hello.sh && ./hello.sh
scripts/01_터미널_권한.sh: line 10: ./hello.sh: Permission denied

$ chmod 755 hello.sh && ./hello.sh
script ran

# 디렉토리에서 x가 없으면 안으로 들어갈 수 없음
$ chmod 644 perm_dir && cd perm_dir
scripts/01_터미널_권한.sh: line 10: cd: perm_dir: Permission denied

$ chmod 755 perm_dir && cd perm_dir && pwd && cd ..
/home/gogosing/codyssey/practice/perm_dir

